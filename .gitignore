# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated art review screenshots — written by --tags preview tests.
tool/preview/

# Encoder input for assets/video/ — ~115MB of source loops, kept out of the
# repo deliberately. `tool/normalise_video.py` reads these to write the seven
# shipped loops in assets/video/, which ARE committed, so a clean clone builds
# and runs. The sources are not derivable from anything here: keep a backup.
raw_assets/assets/videos/

# VS Code Code Runner scratch output. Lands in whatever directory was focused,
# is never valid Dart, and trips the analyzer.
**/tempCodeRunnerFile.dart

# The project this build talks to. Copy `dart_defines.example.json` to
# `dart_defines.json` and fill it in; the publishable key is not a secret the
# way a service key is, but it is per-deployment and a checked-in one is a
# checked-in one (see `SupabaseConfig`).
dart_defines.json

# The release signing key and its passwords. Does not exist yet — the release
# block still uses the debug config — and is ignored ahead of time so that the
# day it does exist is not the day somebody commits a keystore password.
android/key.properties
*.jks
*.keystore

# ── Release signing ────────────────────────────────────────────────────────
#
# Losing these locks the app out of Play updates forever; committing them hands
# anyone who can read the repository the ability to sign an update as you. Both
# failures are permanent, so both files stay out of git and are backed up by
# hand — see KEYSTORE-BACKUP-READ-ME.txt, which is itself ignored because it
# holds the passwords in plain text.
*.jks
*.keystore
android/key.properties
KEYSTORE-BACKUP-READ-ME.txt

# Android Gradle state and packaged app binaries. `build/` already covers the
# usual output paths; these catch a build run from Android Studio, and an APK
# or bundle copied somewhere else to be shared.
android/.gradle/
*.apk
*.aab

# ── Agent and browser tool droppings ───────────────────────────────────────
#
# Headless-browser profiles and PDF/render scratch directories that CLI agents
# leave in the working directory. Nothing here is an input to a build and one
# of them is 66 MB, so they are ignored rather than repeatedly un-staged.
.agents/
.codex/
.codex-*/
.edge-pdf-export/
.playwright-mcp/

# Edge Function secrets. `METERED_REALTIME_SECRET_KEY` and its key id live in
# Supabase's own secret store and are read with `Deno.env.get` at run time —
# nothing in this repository should ever hold their values. These patterns are
# here so that a local `supabase secrets set --env-file` scratch file, or a
# `supabase start` .env, cannot be committed by accident.
supabase/.env
supabase/.env.*
supabase/functions/.env
supabase/functions/.env.*
# `npx supabase` writes these into the project root as it goes. They are the
# CLI's own scratch, not this app's — Flutter has no npm dependencies.
node_modules/
package.json
package-lock.json

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
