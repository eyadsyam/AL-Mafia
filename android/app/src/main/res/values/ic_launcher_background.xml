<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Both are the app's ground, #0F0F0F — `AppColors.groundBase` in
      lib/core/theme/app_colors.dart, and `GROUND` / `ICON_GROUND` in
      tool/generate_icons.py.

      `window_background` is what Android paints *behind* the Flutter surface
      and during launch. It must equal MafiaColors.dark.surfaceBase or the app
      opens on a flash of a different colour and shows it again at the edges of
      every transition, and as a lighter band under the status bar.

      `ic_launcher_background` is the adaptive icon's own backdrop, behind the
      launcher's mask. It used to be near-black while the app ground was warm
      leather; with one ground everywhere there is no longer a reason for the
      icon to be a different colour from the app it opens into.

      Changing either means re-running `python tool/generate_icons.py`, because
      the splash bitmap is composited against these values rather than drawn
      over them.
    -->
    <color name="window_background">#FF0F0F0F</color>
    <color name="ic_launcher_background">#FF0F0F0F</color>
</resources>
