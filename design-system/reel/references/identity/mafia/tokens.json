{
  "$schema_note": "Mafia identity tokens. Every colour is measured from shipped artwork (see IDENTITY.md §3). Each token says where it may appear and where it may never appear. 'inHand' = any surface reachable while one player holds the phone (pass, reveal, night action). Those surfaces may use the ash ink only.",
  "identity": "mafia",
  "version": "1.0.0-draft",
  "date": "2026-10-10",
  "inks": {
    "ash": {
      "meaning": "the cards, the hand, secrecy. Default ink of the app.",
      "share": 0.70,
      "measuredFrom": ["img/cards/*.webp"],
      "allowedInHand": true,
      "tokens": {
        "ground":      { "value": "#0F0F0F", "role": "app background on every ash screen" },
        "raised":      { "value": "#1A1A1A", "role": "panels, rows, tiles" },
        "overlay":     { "value": "#252525", "role": "sheets, dialogs, pressed state" },
        "line":        { "value": "#313131", "role": "hairlines and dividers" },
        "frameRule":   { "value": "#5A5852", "role": "the double printed rule around frames (card border echo)" },
        "textMuted":   { "value": "#908C83", "role": "disabled, placeholders, tertiary text" },
        "text2":       { "value": "#ADA99F", "role": "body and descriptions" },
        "parchment":   { "value": "#C2BDB2", "role": "THE one primary action fill (ابدأ اللعبة). One per screen." },
        "parchmentPressed": { "value": "#8D8169", "role": "pressed primary" },
        "bone":        { "value": "#E9E4D9", "role": "headings, role names, primary text" },
        "onParchment": { "value": "#141312", "role": "label on parchment buttons" }
      }
    },
    "slate": {
      "meaning": "the stage: chapters, phase announcements, the street outside. Measured green-grey cast of the chapter paintings.",
      "share": 0.20,
      "measuredFrom": ["img/stage/chair.webp", "img/stage/door.webp", "img/stage/street.webp"],
      "allowedInHand": false,
      "tokens": {
        "deep":   { "value": "#0B0D0D", "role": "slate ground" },
        "wall":   { "value": "#1C2222", "role": "slate panels" },
        "stone":  { "value": "#272F2E", "role": "progress track, dividers on slate" },
        "mist":   { "value": "#889697", "role": "secondary text on slate (small caption over art)" },
        "paper":  { "value": "#B3AF9E", "role": "progress fill, chapter index tint" },
        "text":   { "value": "#E3DFD3", "role": "announcement headline on slate" }
      }
    },
    "house": {
      "meaning": "the House: vault (الخزنة), council (المجلس), verdict, money, death. Public surfaces only.",
      "share": 0.10,
      "measuredFrom": ["img/house/*.webp"],
      "allowedInHand": false,
      "tokens": {
        "ground":    { "value": "#140F0C", "role": "house screen ground (= DECK-SYSTEM ground)" },
        "panel":     { "value": "#1F1813", "role": "house sheet / panel (= DECK panel)" },
        "raised":    { "value": "#2A211A", "role": "pressed / selected inside house" },
        "line":      { "value": "#3A2D23", "role": "dividers inside house" },
        "oxblood":   { "value": "#562627", "role": "COMMIT colour: the seal, the confirm-purchase button, the verdict band. Never decoration." },
        "oxbloodDeep": { "value": "#3A1416", "role": "seal shadow, pressed commit" },
        "ember":     { "value": "#8E3A32", "role": "elimination line, destructive text, stroke on oxblood" },
        "brass":     { "value": "#C9A45C", "role": "VALUE only: coins, prices, rewards, claim dots (= DECK gold)" },
        "brassDim":  { "value": "#9F825C", "role": "brass borders, coin rim" },
        "brassDeep": { "value": "#7A5C26", "role": "coin shading only" },
        "text":      { "value": "#F1E6D2", "role": "primary text on house" },
        "text2":     { "value": "#C2BBB3", "role": "secondary text on house" }
      }
    }
  },
  "roleAccents_postGameOnly": {
    "note": "luminance matched to ±2%. Result screen and vote reveal only.",
    "mafia": "#916D66", "doctor": "#717573", "detective": "#7D7361", "citizen": "#767471"
  },
  "type": {
    "display":  { "family": "Cairo", "file": "../fonts/Cairo-Variable.ttf", "weights": [800, 900], "use": "screen titles, announcements, the wordmark (the narrator's voice)" },
    "body":     { "family": "IBM Plex Sans Arabic", "files": ["../fonts/IBMPlexSansArabic-Regular.ttf", "../fonts/IBMPlexSansArabic-Medium.ttf", "../fonts/IBMPlexSansArabic-SemiBold.ttf"], "use": "everything else (the ledger's voice)" },
    "index":    { "family": "Bebas Neue", "file": "../fonts/BebasNeue-Regular.ttf", "use": "card-index tags only: chapter numerals, role letters (DR, C, M). Latin only." },
    "figures":  { "family": "IBM Plex Mono", "file": "../fonts/IBMPlexMono-Medium.ttf", "use": "timers, coin amounts, prices. Western digits." },
    "forbidden": ["Aref Ruqaa (belongs to Stories)", "any Latin serif", "system default"],
    "scale_dp": { "wordmark": 46, "screenTitle": 28, "announcement": 30, "cardTitle": 20, "body": 17, "meta": 15, "caption": 13, "indexLarge": 26, "indexSmall": 14 },
    "lineHeight": 1.6, "letterSpacing": 0
  },
  "space_dp": [4, 8, 12, 16, 20, 24, 32, 48, 64],
  "radius_dp": { "button": 4, "chip": 3, "artThumb": 6, "sheetTop": 18, "phoneFrame": 0, "card": 12 },
  "rule": { "frameOuter": 1, "frameGap": 5, "frameInner": 1, "hairline": 1 },
  "motion_ms": { "press": 100, "state": 200, "route": 300, "flip": 600, "phaseHold": 3000, "stagger": 40, "sheet": 260 },
  "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
  "light": { "direction": "from top, start side (top-right in RTL)", "css": "linear-gradient(215deg, rgba(233,228,217,.10), transparent 45%)", "maxOpacity": 0.12, "count": "exactly one per screen" },
  "halftone": { "css": "radial-gradient(rgba(220,216,203,.07) 1px, transparent 1.3px) 0 0/4px 4px", "where": "slate ground only" }
}
