      "type": "word",
      "start": 54.852,
      "end": 55.292
    },
    {
      "text": "بريء».",
      "type": "word",
      "start": 55.345,
      "end": 55.692
    }
  ],
  "cues": [
    {
      "id": 1,
      "text": "تعرف لعبة المافيا؟",
      "start": 0.067,
      "end": 1.04,
      "first_frame": 2,
      "last_frame": 31
    },
    {
      "id": 2,
      "text": "شايف اللي بيقول «أنا بريء»؟",
      "start": 1.4,
      "end": 3.2,
      "first_frame": 42,
      "last_frame": 96
    },
    {
      "id": 3,
      "text": "ده ممكن يطلّعك إنت.",
      "start": 3.511,
      "end": 4.88,
      "first_frame": 105,
      "last_frame": 146
    },
    {
      "id": 4,
      "text": "في سيد المافيا، تلعبوا أونلاين، كل واحد من مكانه.",
      "start": 5.667,
      "end": 8.96,
      "first_frame": 170,
      "last_frame": 269
    },
    {
      "id": 5,
      "text": "كل واحد يعرف دوره لوحده.",
      "start": 9.013,
      "end": 10.56,
      "first_frame": 270,
      "last_frame": 317
    },
    {
      "id": 6,
      "text": "الليل ينزل، والمافيا تختار ضحيتها.",
      "start": 10.72,
      "end": 13.44,
      "first_frame": 322,
      "last_frame": 403
    },
    {
      "id": 7,
      "text": "الدكتور يحاول ينقذ حد.",
      "start": 13.62,
      "end": 15.52,
      "first_frame": 409,
      "last_frame": 466
    },
    {
      "id": 8,
      "text": "والمحقق يكشف دور لاعب.",
      "start": 15.616,
      "end": 18.24,
      "first_frame": 468,
      "last_frame": 547
    },
    {
      "id": 9,
      "text": "الصبح، كله عامل بريء.",
      "start": 18.526,
      "end": 20.32,
      "first_frame": 556,
      "last_frame": 610
    },
    {
      "id": 10,
      "text": "تسألوا، تناقشوا، وتصوّتوا.",
      "start": 20.533,
      "end": 22.72,
      "first_frame": 616,
      "last_frame": 682
    },
    {
      "id": 11,
      "text": "بس لو طلّعتوا الشخص الغلط، المافيا كسبانة منكم.",
      "start": 22.96,
      "end": 26.72,
      "first_frame": 689,
      "last_frame": 802
    },
    {
      "id": 12,
      "text": "فاكر الوش اللي في الأول؟ أهو ده المافيا.",
      "start": 27.952,
      "end": 30.88,
      "first_frame": 839,
      "last_frame": 926
    },
    {
      "id": 13,
      "text": "ومتجمعين؟ العبوا أوفلاين.",
      "start": 31.664,
      "end": 33.684,
      "first_frame": 950,
      "last_frame": 1011
    },
    {
      "id": 14,
      "text": "عايز بقى تمسك حد بالأدلة؟",
      "start": 34.47,
      "end": 36.01,
      "first_frame": 1034,
      "last_frame": 1080
    },
    {
      "id": 15,
      "text": "افتح قصص وتحقيقات.",
      "start": 36.17,
      "end": 38.17,
      "first_frame": 1085,
      "last_frame": 1145
    },
    {
      "id": 16,
      "text": "قضية زي قهوة المعلم: شخصيات تسألها، وأماكن تفتّشها.",
      "start": 38.223,
      "end": 42.17,
      "first_frame": 1147,
      "last_frame": 1265
    },
    {
      "id": 17,
      "text": "وتحرّكاتك محدودة، فاختار هتبدأ بمين.",
      "start": 42.383,
      "end": 45.53,
      "first_frame": 1271,
      "last_frame": 1366
    },
    {
      "id": 18,
      "text": "وفي الآخر تقول: مين عملها؟ وليه؟ وإزاي؟",
      "start": 45.67,
      "end": 49.85,
      "first_frame": 1370,
      "last_frame": 1496
    },
    {
      "id": 19,
      "text": "سيد المافيا. ابعتها لصحابك.",
      "start": 50.719,
      "end": 52.892,
      "first_frame": 1522,
      "last_frame": 1587
    },
    {
      "id": 20,
      "text": "وشوف مين فيهم هيقول «أنا بريء».",
      "start": 53.363,
      "end": 55.692,
      "first_frame": 1601,
      "last_frame": 1671
    }
  ]
}