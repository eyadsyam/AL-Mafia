      "type": "word",
      "start": 53.492,
      "end": 53.612
    },
    {
      "text": "فيهم",
      "type": "word",
      "start": 53.692,
      "end": 54.012
    },
    {
      "text": "هيقول",
      "type": "word",
      "start": 54.092,
      "end": 54.572
    },
    {
