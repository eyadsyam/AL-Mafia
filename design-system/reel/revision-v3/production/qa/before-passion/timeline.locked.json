      "type": "word",
      "start": 16.962,
      "end": 17.078
    },
    {
      "text": "لاعب.",
      "type": "word",
      "start": 17.148,
      "end": 17.508
    },
    {
      "text": "الصبح،",
      "type": "word",
      "start": 17.543,
      "end": 18.112
    },
    {
      "text": "كله",
      "type": "word",
      "start": 18.402,
      "end": 18.646
    },
    {
      "text": "عامل",
      "type": "word",
      "start": 18.68,
      "end": 18.936
    },
    {
      "text": "بريء!",
      "type": "word",
      "start": 18.982,
      "end": 19.354
    },
    {
      "text": "تسألوا،",
      "type": "word",
      "start": 19.656,
      "end": 20.294
    },
    {
      "text": "تناقشوا،",
      "type": "word",
      "start": 20.538,
      "end": 21.188
    },
    {
      "text": "وتصوّتوا.",
      "type": "word",
      "start": 21.293,
      "end": 22.047
    },
    {
      "text": "بس",
      "type": "word",
      "start": 22.338,
      "end": 22.535
    },
    {
      "text": "لو",
      "type": "word",
      "start": 22.593,
      "end": 22.663
    },
    {
      "text": "طلّعتوا",
      "type": "word",
      "start": 22.709,
      "end": 23.046
    },
    {
      "text": "الشخص",
      "type": "word",
      "start": 23.069,
      "end": 23.371
    },
    {
      "text": "الغلط،",
      "type": "word",
      "start": 23.429,
      "end": 23.835
    },
    {
      "text": "المافيا",
      "type": "word",
      "start": 23.87,
      "end": 24.253
    },
    {
      "text": "كسبانة",
      "type": "word",
      "start": 24.288,
      "end": 24.694
    },
    {
      "text": "منكم.",
      "type": "word",
      "start": 24.741,
      "end": 25.182
    },
    {
      "text": "فاكر",
      "type": "word",
      "start": 25.403,
      "end": 25.693
    },
    {
      "text": "الوش",
      "type": "word",
      "start": 25.739,
      "end": 26.041
    },
    {
      "text": "اللي",
      "type": "word",
      "start": 26.122,
      "end": 26.239
    },
    {
      "text": "في",
      "type": "word",
      "start": 26.262,
      "end": 26.32
    },
    {
      "text": "الأول؟",
      "type": "word",
      "start": 26.343,
      "end": 26.807
    },
    {
      "text": "أهو",
      "type": "word",
      "start": 27.028,
      "end": 27.179
    },
    {
      "text": "ده",
      "type": "word",
      "start": 27.249,
      "end": 27.307
    },
    {
      "text": "المافيا!",
      "type": "word",
      "start": 27.33,
      "end": 27.794
    },
    {
      "text": "ومتجمعين؟",
      "type": "word",
      "start": 27.91,
      "end": 28.828
    },
    {
      "text": "العبوا",
      "type": "word",
      "start": 29.129,
      "end": 29.489
    },
    {
      "text": "أوفلاين.",
      "type": "word",
      "start": 29.513,
      "end": 30.058
    },
    {
      "text": "عايز",
      "type": "word",
      "start": 30.279,
      "end": 30.546
    },
    {
      "text": "بقى",
      "type": "word",
      "start": 30.604,
      "end": 30.72
    },
    {
      "text": "تمسك",
      "type": "word",
      "start": 30.755,
      "end": 31.01
    },
    {
      "text": "حد",
      "type": "word",
      "start": 31.068,
      "end": 31.242
    },
    {
      "text": "بالأدلة؟",
      "type": "word",
      "start": 31.312,
      "end": 31.788
    },
    {
      "text": "افتح",
      "type": "word",
      "start": 32.009,
      "end": 32.311
    },
    {
      "text": "قصص",
      "type": "word",
      "start": 32.38,
      "end": 32.624
    },
    {
      "text": "وتحقيقات.",
      "type": "word",
      "start": 32.659,
      "end": 33.402
    },
    {
      "text": "قضية",
      "type": "word",
      "start": 33.646,
      "end": 33.971
    },
    {
      "text": "زي",
      "type": "word",
      "start": 34.04,
      "end": 34.238
    },
    {
      "text": "قهوة",
      "type": "word",
      "start": 34.307,
      "end": 34.655
    },
    {
      "text": "المعلم:",
      "type": "word",
      "start": 34.69,
      "end": 35.259
    },
    {
      "text": "شخصيات",
      "type": "word",
      "start": 35.41,
      "end": 35.909
    },
    {
      "text": "تسألها،",
      "type": "word",
      "start": 35.944,
      "end": 36.56
    },
    {
      "text": "وأماكن",
      "type": "word",
      "start": 36.722,
      "end": 37.233
    },
    {
      "text": "تفتّشها.",
      "type": "word",
      "start": 37.291,
      "end": 37.999
    },
    {
      "text": "وتحرّكاتك",
      "type": "word",
      "start": 38.324,
      "end": 39.102
    },
    {
      "text": "محدودة،",
      "type": "word",
      "start": 39.172,
      "end": 39.764
    },
    {
      "text": "فاختار",
      "type": "word",
      "start": 40.008,
      "end": 40.379
    },
    {
      "text": "هتبدأ",
      "type": "word",
      "start": 40.426,
      "end": 40.809
    },
    {
      "text": "بمين.",
      "type": "word",
      "start": 40.844,
      "end": 41.354
    },
    {
      "text": "وفي",
      "type": "word",
      "start": 41.738,
      "end": 41.97
    },
    {
      "text": "الآخر",
      "type": "word",
      "start": 41.993,
      "end": 42.353
    },
    {
      "text": "تقول:",
      "type": "word",
      "start": 42.399,
      "end": 42.933
    },
    {
      "text": "مين",
      "type": "word",
      "start": 43.212,
      "end": 43.444
    },
    {
      "text": "عملها؟",
      "type": "word",
      "start": 43.491,
      "end": 43.967
    },
    {
      "text": "وليه؟",
      "type": "word",
      "start": 44.036,
      "end": 44.512
    },
    {
      "text": "وإزاي؟",
      "type": "word",
      "start": 44.721,
      "end": 45.36
    },
    {
      "text": "سيد",
      "type": "word",
      "start": 45.476,
      "end": 45.766
    },
    {
      "text": "المافيا.",
      "type": "word",
      "start": 45.813,
      "end": 46.335
    },
    {
      "text": "ابعتها",
      "type": "word",
      "start": 46.509,
      "end": 46.916
    },
    {
      "text": "لصحابك!",
      "type": "word",
      "start": 46.962,
      "end": 47.601
    },
    {
      "text": "وشوف",
      "type": "word",
      "start": 47.775,
      "end": 48.1
    },
    {
      "text": "مين",
      "type": "word",
      "start": 48.193,
      "end": 48.309
    },
    {
      "text": "فيهم",
      "type": "word",
      "start": 48.378,
      "end": 48.646
    },
    {
      "text": "هيقول",
      "type": "word",
      "start": 48.715,
      "end": 49.156
    },
    {
      "text": "«أنا",
      "type": "word",
      "start": 49.272,
      "end": 49.679
    },
    {
      "text": "بريء».",
      "type": "word",
      "start": 49.737,
      "end": 50.433
    }
  ],
  "cues": [
    {
      "id": 1,
      "text": "تعرف لعبة المافيا؟",
      "start": 0,
      "end": 1.289,
      "first_frame": 0,
      "last_frame": 39
    },
    {
      "id": 2,
      "text": "شايف صاحبك اللي بيقول «أنا بريء»؟",
      "start": 1.649,
      "end": 3.808,
      "first_frame": 49,
      "last_frame": 114
    },
    {
      "id": 3,
      "text": "ده ممكن يطلّعك إنت!",
      "start": 4.156,
      "end": 5.433,
      "first_frame": 125,
      "last_frame": 163
    },
    {
      "id": 4,
      "text": "في سيد المافيا، تلعبوا أونلاين، كل واحد من مكانه.",
      "start": 5.979,
      "end": 9.915,
      "first_frame": 179,
      "last_frame": 297
    },
    {
      "id": 5,
      "text": "كل واحد يعرف دوره لوحده.",
      "start": 10.17,
      "end": 11.61,
      "first_frame": 305,
      "last_frame": 348
    },
    {
      "id": 6,
      "text": "الليل ينزل، والمافيا تختار ضحيتها.",
      "start": 12.016,
      "end": 14.35,
      "first_frame": 360,
      "last_frame": 430
    },
    {
      "id": 7,
      "text": "الدكتور يحاول ينقذ حد.",
      "start": 14.408,
      "end": 15.79,
      "first_frame": 432,
      "last_frame": 474
    },
    {
      "id": 8,
      "text": "والمحقق يكشف دور لاعب.",
      "start": 16.045,
      "end": 17.508,
      "first_frame": 481,
      "last_frame": 525
    },
    {
      "id": 9,
      "text": "الصبح، كله عامل بريء!",
      "start": 17.543,
      "end": 19.354,
      "first_frame": 526,
      "last_frame": 581
    },
    {
      "id": 10,
      "text": "تسألوا، تناقشوا، وتصوّتوا.",
      "start": 19.656,
      "end": 22.047,
      "first_frame": 590,
      "last_frame": 661
    },
    {
      "id": 11,
      "text": "بس لو طلّعتوا الشخص الغلط، المافيا كسبانة منكم.",
      "start": 22.338,
      "end": 25.182,
      "first_frame": 670,
      "last_frame": 755
    },
    {
      "id": 12,
      "text": "فاكر الوش اللي في الأول؟ أهو ده المافيا!",
      "start": 25.403,
      "end": 27.794,
      "first_frame": 762,
      "last_frame": 834
    },
    {
      "id": 13,
      "text": "ومتجمعين؟ العبوا أوفلاين.",
      "start": 27.91,
      "end": 30.058,
      "first_frame": 837,
      "last_frame": 902
    },
    {
      "id": 14,
      "text": "عايز بقى تمسك حد بالأدلة؟",
      "start": 30.279,
      "end": 31.788,
      "first_frame": 908,
      "last_frame": 954
    },
    {
      "id": 15,
      "text": "افتح قصص وتحقيقات.",
      "start": 32.009,
      "end": 33.402,
      "first_frame": 960,
      "last_frame": 1002
    },
    {
      "id": 16,
      "text": "قضية زي قهوة المعلم: شخصيات تسألها، وأماكن تفتّشها.",
      "start": 33.646,
      "end": 37.999,
      "first_frame": 1009,
      "last_frame": 1140
    },
    {
      "id": 17,
      "text": "وتحرّكاتك محدودة، فاختار هتبدأ بمين.",
      "start": 38.324,
      "end": 41.354,
      "first_frame": 1150,
      "last_frame": 1241
    },
    {
      "id": 18,
      "text": "وفي الآخر تقول: مين عملها؟ وليه؟ وإزاي؟",
      "start": 41.738,
      "end": 45.36,
      "first_frame": 1252,
      "last_frame": 1361
    },
    {
      "id": 19,
      "text": "سيد المافيا. ابعتها لصحابك!",
      "start": 45.476,
      "end": 47.601,
      "first_frame": 1364,
      "last_frame": 1428
    },
    {
      "id": 20,
      "text": "وشوف مين فيهم هيقول «أنا بريء».",
      "start": 47.775,
      "end": 50.433,
      "first_frame": 1433,
      "last_frame": 1513
    }
  ],
