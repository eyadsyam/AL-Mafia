    }
  ],
  "cues": [
    {
      "id": 1,
      "text": "تعرف لعبة المافيا؟",
      "start": 0.139,
      "end": 1.2,
      "first_frame": 4,
      "last_frame": 36
    },
    {
      "id": 2,
      "text": "شايف صاحبك اللي بيقول «أنا بريء»؟",
      "start": 1.93,
      "end": 3.77,
      "first_frame": 58,
      "last_frame": 113
    },
    {
      "id": 3,
      "text": "ده ممكن يطلّعك إنت!",
      "start": 4.01,
      "end": 5.85,
      "first_frame": 120,
      "last_frame": 176
    },
    {
      "id": 4,
      "text": "في سيد المافيا، تلعبوا أونلاين، كل واحد من مكانه.",
      "start": 6.73,
      "end": 10.29,
      "first_frame": 202,
      "last_frame": 309
    },
    {
      "id": 5,
      "text": "كل واحد يعرف دوره لوحده.",
      "start": 10.703,
      "end": 12.09,
      "first_frame": 321,
      "last_frame": 363
    },
    {
      "id": 6,
      "text": "الليل ينزل، والمافيا تختار ضحيتها.",
      "start": 12.710401,
      "end": 15.150401,
      "first_frame": 381,
      "last_frame": 455
    },
    {
      "id": 7,
      "text": "الدكتور يحاول ينقذ حد.",
      "start": 15.330401,
      "end": 17.390401,
      "first_frame": 460,
      "last_frame": 522
    },
    {
      "id": 8,
      "text": "والمحقق يكشف دور لاعب.",
      "start": 17.486401,
      "end": 19.390401,
      "first_frame": 525,
      "last_frame": 582
    },
    {
      "id": 9,
      "text": "الصبح، كله عامل بريء!",
      "start": 20.038318999999998,
      "end": 21.828318999999997,
      "first_frame": 601,
      "last_frame": 655
    },
    {
      "id": 10,
      "text": "تسألوا، تناقشوا، وتصوّتوا.",
      "start": 22.26897199999999,
      "end": 24.50497199999999,
      "first_frame": 668,
      "last_frame": 735
    },
    {
      "id": 11,
      "text": "بس لو طلّعتوا الشخص الغلط، المافيا كسبانة منكم.",
      "start": 24.624971999999993,
      "end": 28.144971999999992,
      "first_frame": 739,
      "last_frame": 844
    },
    {
      "id": 12,
      "text": "فاكر الوش اللي في الأول؟ أهو ده المافيا!",
      "start": 28.606284999999996,
      "end": 30.951285,
      "first_frame": 858,
      "last_frame": 929
    },
    {
      "id": 13,
      "text": "ومتجمعين؟ العبوا أوفلاين.",
      "start": 31.282196999999996,
      "end": 33.194196999999996,
      "first_frame": 938,
      "last_frame": 996
    },
    {
      "id": 14,
      "text": "عايز بقى تمسك حد بالأدلة؟",
      "start": 33.444196999999996,
      "end": 35.054196999999995,
      "first_frame": 1003,
      "last_frame": 1052
    },
    {
      "id": 15,
      "text": "افتح قصص وتحقيقات.",
      "start": 35.72684099999999,
      "end": 36.774840999999995,
      "first_frame": 1072,
      "last_frame": 1103
    },
    {
      "id": 16,
      "text": "قضية زي قهوة المعلم: شخصيات تسألها، وأماكن تفتّشها.",
      "start": 37.01484099999999,
      "end": 41.65484099999999,
      "first_frame": 1110,
      "last_frame": 1250
    },
    {
      "id": 17,
      "text": "وتحرّكاتك محدودة، فاختار هتبدأ بمين.",
      "start": 41.92184099999999,
      "end": 45.33484099999999,
      "first_frame": 1258,
      "last_frame": 1360
    },
    {
      "id": 18,
      "text": "وفي الآخر تقول: مين عملها؟ وليه؟ وإزاي؟",
      "start": 45.58484099999999,
      "end": 49.99984099999999,
      "first_frame": 1368,
      "last_frame": 1500
    },
    {
      "id": 19,
      "text": "سيد المافيا. ابعتها لصحابك!",
      "start": 50.33642599999999,
      "end": 52.66642599999999,
      "first_frame": 1510,
      "last_frame": 1580
    },
    {
      "id": 20,
      "text": "وشوف مين فيهم هيقول «أنا بريء».",
      "start": 52.93108999999998,
      "end": 55.694769999999984,
      "first_frame": 1588,
      "last_frame": 1671
    }
  ],
