      "delivery": "Three actions with natural progression.",
      "pause_guidance": "Brief commas.",
      "timing_status": "editorial_target_not_measured"
    },
    {
      "id": "C11",
      "start_frame": 810,
      "end_frame": 900,
      "text": "طلّعتوا بريء؟ المافيا بتشكركم.",
