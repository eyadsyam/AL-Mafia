      "pause_guidance": "100–180 ms between questions.",
      "timing_status": "editorial_target_not_measured"
    },
    {
      "id": "C10",
      "start_frame": 720,
      "end_frame": 810,
      "text": "تتناقشوا، تصوّتوا، وتطلّعوا حد.",
