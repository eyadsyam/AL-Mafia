      "pause_guidance": "No long pause.",
      "timing_status": "editorial_target_not_measured"
    },
    {
      "id": "C05",
      "start_frame": 354,
      "end_frame": 435,
      "text": "بالليل، المافيا تختار ضحيتها.",
