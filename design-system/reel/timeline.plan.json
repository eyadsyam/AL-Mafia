      "delivery": "Energy drops briefly then curiosity rises.",
      "pause_guidance": "150–250 ms at ellipsis.",
      "timing_status": "editorial_target_not_measured"
    },
    {
      "id": "C09",
      "start_frame": 630,
      "end_frame": 720,
      "text": "مين بيكدب؟ ومين بيغيّر كلامه؟",
      "tag": "",
