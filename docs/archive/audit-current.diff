+        _spotlight.value = 1;
+      } else if (_spotlight.value == 0) {
+        _spotlight.forward(from: 0);
+      }
+    } else {
+      _spotlight.value = 0;
+    }
+
+    ref.read(ownRecordProvider.notifier).observe(snapshot);
+  }
