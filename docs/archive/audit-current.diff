+    const { data: target } = await db
+      .from("room_players")
+      .select("role")
+      .eq("room_id", roomId)
+      .eq("user_id", targetId)
+      .maybeSingle();
+    return ok({ revealedRole: target?.role ?? null, bulletSpent: spending });
+  }
