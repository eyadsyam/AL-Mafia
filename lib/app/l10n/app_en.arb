  "rulesGoalTitle": "The goal",
  "rulesGoalBody": "The townspeople look for the mafia and vote them out.\nThe mafia kill one person a night until the town is finished.",
  "rulesRolesTitle": "The roles",
  "rulesDayTitle": "Day phase",
  "rulesDayBody": "1. Discussion: everyone speaks and defends themselves.\n2. Accusation: everyone points their suspicion at someone.\n3. Vote: the group decides who goes.",
  "rulesNightTitle": "Night phase",
  "rulesNightBody": "Each player takes the phone alone and does their part:\n— Mafia: agree on someone to kill.\n— Detective: choose someone to check.\n— Doctor: choose someone to protect.\n— Citizen: pass the phone on without doing anything.",
  "rulesWinTitle": "Winning",
  "rulesWinBody": "The town wins if every mafia is voted out.\nThe mafia win once they equal the number of townspeople.",
  "rulesTipsTitle": "Tips",
