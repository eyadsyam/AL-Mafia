# Cloudflare Pages headers (mirrors web/vercel.json).
# No _redirects on purpose: without a 404.html Pages already falls back to
# /index.html for unknown paths, and static pages like /privacy/ still win.
/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/canvaskit/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/.well-known/assetlinks.json
  ! Cache-Control
  Content-Type: application/json
  Cache-Control: public, max-age=300
